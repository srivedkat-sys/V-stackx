'fea_y': [0,113,282.5,565,847.5,1130],
'fea_d': [0,1.375,7.15,23.662,44.459,66.414]
}

]


# ================= FUNCTION =================
def predict_span(config, n_points=200):
    L = config['L']
    y_vals = np.linspace(0, L, n_points)

    inputs = []
    for y in y_vals:
        row = config.copy()
        row['y'] = y
        inputs.append([row[k] for k in INPUT_COLS])

    X = np.array(inputs, dtype=np.float32)
    X_scaled = in_scaler.transform(X)
    X_t = torch.tensor(X_scaled, device=device)

    with torch.no_grad():
        v_pred, _ = model(X_t)

    v_pred = v_pred.cpu().numpy().flatten()
    v_pred = v_pred * out_scaler.scale_ + out_scaler.mean_

    return y_vals, v_pred


# ================= LOOP =================
for i, case in enumerate(cases):

    y_pred, v_pred = predict_span(case['config'])

    # Interpolate predictions at FEA points
    interp_pred = np.interp(case['fea_y'], y_pred, v_pred)

    # RMSE
    rmse = np.sqrt(np.mean((interp_pred - case['fea_d'])**2))

    # Plot
    plt.figure(figsize=(6,4))

    plt.plot(y_pred, v_pred, linewidth=2, label='PINN')
    plt.scatter(case['fea_y'], case['fea_d'], color='red', label='FEA')

    plt.title(f'Case {i+1} | RMSE = {rmse:.3f} mm')
    plt.xlabel("Span (y)")
    plt.ylabel("Deflection (mm)")
    plt.legend()
    plt.grid()

    plt.show()



