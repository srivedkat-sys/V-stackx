# 4. SPARSE DATA VALIDATION — Check training points
# =============================================================

def sparse_data_validation(df, surrogate):
    """Verify predictions at the exact 3 training points per wing"""
    print("\n" + "=" * 57)
    print("  SPARSE DATA VALIDATION — Training Points (Root, Mid, Tip)")
    print("=" * 57)
    
    unique_cfgs = df[CONFIG_COLS].drop_duplicates().reset_index(drop=True)
    
    all_errors = {'root': [], 'mid': [], 'tip': []}
    
    for _, cfg in unique_cfgs.iterrows():
        L_c = float(cfg['L'])
        
        # Get training data for this config
        cfg_rows = df[
            (df['L'] == cfg['L']) & (df['c'] == cfg['c']) &
            (df['t_c'] == cfg['t_c']) & (df['xf'] == cfg['xf']) &
            (df['xr'] == cfg['xr']) & (df['ts'] == cfg['ts']) &
            (df['tw'] == cfg['tw']) & (df['n_ribs'] == cfg['n_ribs']) &
            (df['E'] == cfg['E']) & (df['p'] == cfg['p'])
        ].sort_values('y')
        
        for _, row in cfg_rows.iterrows():
            y_pos = row['y']
            d_true = row['D']
            d_pred = surrogate.predict_v(
                L_c, float(cfg['c']), float(cfg['t_c']),
                float(cfg['xf']), float(cfg['xr']),
                float(cfg['ts']), float(cfg['tw']),
                int(cfg['n_ribs']), float(cfg['E']),
                float(cfg['p']), y_pos)
            
            err = abs(d_pred - d_true)
            
            if y_pos == 0:
                all_errors['root'].append(err)
            elif abs(y_pos - L_c/2) < L_c/4:  # Mid-span
                all_errors['mid'].append(err)
            else:
                all_errors['tip'].append(err)
    
    print(f"\n  Root (y=0) — Training data: D=0 (explicit BC)")
    print(f"    Mean error: {np.mean(all_errors['root']):.4f} mm")
    print(f"    Max error:  {np.max(all_errors['root']):.4f} mm")
    
    print(f"\n  Mid-span (y=L/2) — Training data anchor")
    print(f"    Mean error: {np.mean(all_errors['mid']):.4f} mm")
    print(f"    Max error:  {np.max(all_errors['mid']):.4f} mm")
    
    print(f"\n  Tip (y=L) — Training data anchor")
    print(f"    Mean error: {np.mean(all_errors['tip']):.4f} mm")
    print(f"    Max error:  {np.max(all_errors['tip']):.4f} mm")
    
    return all_errors


