# 6. EXTRAPOLATION ANALYSIS
# =============================================================

def extrapolation_analysis(df, surrogate):
    print(f"\n{'─'*57}")
    print("  EXTRAPOLATION ANALYSIS")
    print(f"{'─'*57}")

    med = df[CONFIG_COLS].drop_duplicates().median()
    base = {col: float(med[col]) for col in CONFIG_COLS}
    L_max = df['L'].max()

    print(f"  Base config: L={base['L']:.0f}mm  c={base['c']:.0f}mm  "
          f"p={base['p']:.4f}MPa")
    print(f"  Training L range: {df['L'].min():.0f}–{L_max:.0f}mm")
    print(f"\n  {'L(mm)':>8} {'Overshoot':>10} {'D_analy':>9} "
          f"{'D_PINN':>9} {'Err%':>8}")
    print(f"  {'─'*50}")

    fracs   = [0.0, 0.05, 0.10, 0.15, 0.20, 0.25, 0.30]
    extrap_errs = []
    extrap_Ls   = []

    for frac in fracs:
        L_t = L_max * (1 + frac)
        I_t = compute_I_numeric(base['c'],  base['t_c'],
                                base['ts'], base['tw'],
                                base['xf'], base['xr'])
        w_t  = base['p'] * base['c']
        EI_t = base['E'] * I_t
        d_an = (w_t * L_t**4) / (8.0 * EI_t)
        d_pinn = surrogate.predict_v(
            L_t, base['c'], base['t_c'], base['xf'], base['xr'],
            base['ts'], base['tw'], int(base['n_ribs']),
            base['E'], base['p'], L_t)
        err = abs(d_pinn-d_an)/(d_an+1e-10)*100
        extrap_errs.append(err)
        extrap_Ls.append(L_t)
        region = 'interpolation' if frac==0 else f'+{frac*100:.0f}%'
        print(f"  {L_t:>8.0f} {frac*100:>9.0f}% {d_an:>9.2f} "
              f"{d_pinn:>9.2f} {err:>7.2f}%  {region}")

    interp_err  = extrap_errs[0]
    mild_errs   = [extrap_errs[i] for i in [1,2,3]]
    aggr_errs   = [extrap_errs[i] for i in [4,5,6]]
    EDF_mild    = np.mean(mild_errs)  / (interp_err+1e-10)
    EDF_aggr    = np.mean(aggr_errs)  / (interp_err+1e-10)

    print(f"\n  EDF (mild  +5–15%): {EDF_mild:.1f}×")
    print(f"  EDF (aggr +20–30%): {EDF_aggr:.1f}×")

    return fracs, extrap_errs, extrap_Ls


