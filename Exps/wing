# 5. FULL DATASET VALIDATION (All span locations)
# =============================================================

def full_dataset_validation(df, surrogate):
    print(f"\n{'─'*57}")
    print("  FULL DATASET VALIDATION — All Span Locations")
    print(f"{'─'*57}")

    records = []
    skipped = 0

    for _, row in df.iterrows():
        EI_r, w_r, _ = get_EI_w(row)
        L_r = float(row['L']); y_r = float(row['y'])
        d_an = delta_at(y_r, w_r, L_r, EI_r)
        if d_an < SKIP_THRESHOLD:
            skipped += 1; continue

        d_act = float(row['D'])
        d_pinn = surrogate.predict_v(
            float(row['L']), float(row['c']), float(row['t_c']),
            float(row['xf']), float(row['xr']), float(row['ts']),
            float(row['tw']), int(row['n_ribs']),
            float(row['E']),  float(row['p']), y_r)

        denom = max(abs(d_act), SKIP_THRESHOLD)
        records.append({
            'frac':    y_r/L_r,
            'D':       d_act,
            'D_an':    d_an,
            'D_pinn':  d_pinn,
            'err_pct': abs(d_pinn-d_act)/denom*100,
            'err_abs': abs(d_pinn-d_act),
            'c':       float(row['c']),
            'p':       float(row['p']),
        })

    errs     = np.array([r['err_pct'] for r in records])
    abs_errs = np.array([r['err_abs'] for r in records])
    act_arr  = np.array([r['D']       for r in records])
    pred_arr = np.array([r['D_pinn']  for r in records])

    ss_res = np.sum((act_arr-pred_arr)**2)
    ss_tot = np.sum((act_arr-act_arr.mean())**2)
    r2     = 1 - ss_res/(ss_tot+1e-12)
    rmse   = np.sqrt(np.mean((act_arr-pred_arr)**2))
    mae    = np.mean(np.abs(act_arr-pred_arr))
    maxae  = np.max(np.abs(act_arr-pred_arr))
    nrmse  = rmse/(act_arr.max()-act_arr.min())*100

    print(f"\n  Rows validated : {len(records)}")
    print(f"  Rows skipped   : {skipped}  (< {SKIP_THRESHOLD}mm)")
    print(f"\n  ┌─────────────────────────────────────────┐")
    print(f"  │  SPLIT PINN (ConfigEncoder) — METRICS   │")
    print(f"  ├─────────────────────────────────────────┤")
    print(f"  │  R²                    : {r2:>8.4f}          │")
    print(f"  │  RMSE (mm)             : {rmse:>8.4f}          │")
    print(f"  │  NRMSE (%)             : {nrmse:>8.4f}          │")
    print(f"  │  MAE (mm)              : {mae:>8.4f}          │")
    print(f"  │  Max AE (mm)           : {maxae:>8.4f}          │")
    print(f"  │  Mean rel error        : {errs.mean():>7.2f}%          │")
    print(f"  │  Median rel error      : {np.median(errs):>7.2f}%          │")
    print(f"  │  Max rel error         : {errs.max():>7.2f}%          │")
    print(f"  │  Rows within 5%        : {(errs<5).sum()/len(errs)*100:>7.1f}%          │")
    print(f"  │  Rows within 10%       : {(errs<10).sum()/len(errs)*100:>7.1f}%          │")
    print(f"  └─────────────────────────────────────────┘")

    print(f"\n  Breakdown by span location:")
    print(f"  {'Location':<12} {'Mean%':>7} {'Median%':>8} "
          f"{'Max%':>7} {'MaxAbs':>8}  n")
    print(f"  {'─'*52}")
    frac_groups = {}
    for frac, lbl in [(0.10,'10%'),(0.25,'25%'),(0.50,'50%'),
                      (0.75,'75%'),(1.00,'Tip')]:
        grp = [r for r in records if abs(r['frac']-frac) < 0.05]
        if grp:
            gp = np.array([r['err_pct'] for r in grp])
            ga = np.array([r['err_abs'] for r in grp])
            frac_groups[lbl] = {'pct': gp, 'abs': ga}
            print(f"  {lbl:<12} {gp.mean():>7.2f}% "
                  f"{np.median(gp):>7.2f}% "
                  f"{gp.max():>7.2f}% {ga.max():>7.3f}mm  {len(grp)}")

    return records, r2, rmse, nrmse, mae, maxae, errs, act_arr, pred_arr, frac_groups


