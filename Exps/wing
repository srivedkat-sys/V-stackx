import torch
import torch.nn as nn
import numpy as np
import matplotlib.pyplot as plt
import sklearn.preprocessing._data

# ================= SAFE LOAD =================
torch.serialization.add_safe_globals([sklearn.preprocessing._data.StandardScaler])

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

MODEL_PATH = "best_split_pinn_FINAL.pth"

INPUT_COLS  = ['L','c','t_c','xf','xr','ts','tw','n_ribs','E','p','y']
CONFIG_COLS = ['L','c','t_c','xf','xr','ts','tw','n_ribs','E','p']
IDX_Y = 10


# ================= MODEL =================
class ConfigEncoder(nn.Module):
    def __init__(self):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(10, 32), nn.Tanh(),
            nn.Linear(32, 16), nn.Tanh(),
            nn.Linear(16, 1)
        )

    def forward(self, config):
        return torch.exp(self.net(config) + 10.0)


class SplitPINN(nn.Module):
    def __init__(self):
        super().__init__()
        self.freqs = torch.arange(1, 11).float()

        self.net = nn.Sequential(
            nn.Linear(11 + 20, 64), nn.Tanh(),
            nn.Linear(64, 64), nn.Tanh(),
            nn.Linear(64, 64), nn.Tanh(),
            nn.Linear(64, 2)
        )

    def fourier(self, x):
        y = x[:, IDX_Y:IDX_Y+1]
        f = self.freqs.to(x.device)
        return torch.cat([
            torch.sin(2*np.pi*f*y/250.0),
            torch.cos(2*np.pi*f*y/250.0)
        ], dim=1)

    def forward(self, x):
        out = self.net(torch.cat([x, self.fourier(x)], dim=1))
        return out[:,0:1], out[:,1:2]


# ================= LOAD =================
ckpt = torch.load(MODEL_PATH, map_location=device, weights_only=False)

model = SplitPINN().to(device)
ei_encoder = ConfigEncoder().to(device)

model.load_state_dict(ckpt['model'])
ei_encoder.load_state_dict(ckpt['ei_encoder'])

in_scaler  = ckpt['in_scaler']
out_scaler = ckpt['out_scaler']

model.eval()


# ================= CASES =================
cases = [

{
