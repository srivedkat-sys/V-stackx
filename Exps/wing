# =============================================================
# 1. STRUCTURAL FUNCTIONS
# =============================================================

def naca_thickness(x, c, t_c):
    x_c = x / c
    a0,a1,a2,a3,a4 = 0.2969,-0.1260,-0.3516,0.2843,-0.1015
    return (t_c/0.2)*(a0*np.sqrt(x_c)+a1*x_c+a2*x_c**2+
                      a3*x_c**3+a4*x_c**4)*c

def compute_I_numeric(c, t_c, ts, tw, xf, xr):
    n=200; x=np.linspace(0,c,n)
    yt=naca_thickness(x,c,t_c)
    dyt_dx=np.gradient(yt,x)
    ds=np.sqrt(1+dyt_dx**2); dx=c/(n-1)
    I_skin=2*ts*np.sum(yt**2*ds)*dx
    I_spar_f=tw*(2*naca_thickness(xf,c,t_c))**3/12
    I_spar_r=tw*(2*naca_thickness(xr,c,t_c))**3/12
    return I_skin+I_spar_f+I_spar_r

def delta_at(y, w, L, EI):
    """Analytical deflection: v(y) = (w/24EI)(6L²y²-4Ly³+y⁴)"""
    return (w/(24*EI))*(6*L**2*y**2 - 4*L*y**3 + y**4)

def moment_at(y, w, L):
    """Analytical bending moment: M(y) = (w/2)(L-y)²"""
    return (w/2)*(L-y)**2

def get_EI_w(row):
    I  = compute_I_numeric(float(row['c']),  float(row['t_c']),
                           float(row['ts']), float(row['tw']),
                           float(row['xf']), float(row['xr']))
    EI = float(row['E']) * I
    w  = float(row['p']) * float(row['c'])
    return EI, w, I


# =============================================================
# 2. MODEL DEFINITIONS (must match training exactly)
# =============================================================

class ConfigEncoder(nn.Module):
    def __init__(self):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(10, 32), nn.Tanh(),
            nn.Linear(32, 16), nn.Tanh(),
            nn.Linear(16, 1)
        )

    def forward(self, config):
        return torch.exp(self.net(config) + 10.0)


class SplitPINN(nn.Module):
    def __init__(self):
        super().__init__()
        self.freqs = torch.arange(1, 11).float()
        self.net = nn.Sequential(
            nn.Linear(11 + 20, 64), nn.Tanh(),
            nn.Linear(64, 64), nn.Tanh(),
            nn.Linear(64, 64), nn.Tanh(),
            nn.Linear(64, 2)
        )

    def fourier(self, x):
        y = x[:, IDX_Y:IDX_Y+1]
        f = self.freqs.to(x.device)
        return torch.cat([
            torch.sin(2*np.pi*f*y/250.0),
            torch.cos(2*np.pi*f*y/250.0)
        ], dim=1)

    def forward(self, x):
        x = torch.cat([x, self.fourier(x)], dim=1)
        out = self.net(x)
        return out[:,0:1], out[:,1:2]


# =============================================================
# 3. SURROGATE WRAPPER
# =============================================================

class SplitPINNSurrogate:
    def __init__(self, path=MODEL_PATH):
        ckpt = torch.load(path, map_location=device, weights_only=False)
        
        self.model = SplitPINN().to(device)
        self.model.load_state_dict(ckpt['model'])
        self.model.eval()
        
        self.ei_encoder = ConfigEncoder().to(device)
        self.ei_encoder.load_state_dict(ckpt['ei_encoder'])
        self.ei_encoder.eval()
        
        self.in_scaler  = ckpt['in_scaler']
        self.out_scaler = ckpt['out_scaler']
        
        print(f"✓ SplitPINN (ConfigEncoder) loaded from {path}")

    def predict(self, L, c, t_c, xf, xr, ts, tw, n_ribs, E, p, y):
        """Returns (deflection_mm, moment_normalised)"""
        X  = np.array([[L,c,t_c,xf,xr,ts,tw,n_ribs,E,p,y]],
                      dtype=np.float32)
        Xs = self.in_scaler.transform(X)
        Xt = torch.tensor(Xs, device=device, dtype=torch.float32)
        
        with torch.no_grad():
            v_sc, M_sc = self.model(Xt)
        
        v = float(v_sc.cpu().numpy()) * self.out_scaler.scale_[0] \
            + self.out_scaler.mean_[0]
        M = float(M_sc.cpu().numpy())
        return v, M

    def predict_v(self, L, c, t_c, xf, xr, ts, tw, n_ribs, E, p, y):
        v, _ = self.predict(L,c,t_c,xf,xr,ts,tw,n_ribs,E,p,y)
        return v

    def predict_span(self, cfg, n_points=200):
        y_vals = np.linspace(0, cfg['L'], n_points)
        vs, Ms = [], []
        for y in y_vals:
            v, M = self.predict(cfg['L'], cfg['c'], cfg['t_c'],
                                cfg['xf'], cfg['xr'], cfg['ts'],
                                cfg['tw'], int(cfg['n_ribs']),
                                cfg['E'],  cfg['p'], y)
            vs.append(v); Ms.append(M)
        return y_vals, np.array(vs), np.array(Ms)

    def predict_EI(self, L, c, t_c, xf, xr, ts, tw, n_ribs, E, p):
        """Predict EI from geometry using ConfigEncoder"""
        X = np.array([[L,c,t_c,xf,xr,ts,tw,n_ribs,E,p]], dtype=np.float32)
        Xs = self.in_scaler.transform(X)[:, :10]  # First 10 columns are config
        Xt = torch.tensor(Xs, device=device, dtype=torch.float32)
        with torch.no_grad():
            EI = self.ei_encoder(Xt)
        return float(EI.cpu().numpy())


