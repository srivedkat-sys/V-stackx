import os
import numpy as np
import pandas as pd
import torch
import torch.nn as nn
import torch.optim as optim
from sklearn.preprocessing import StandardScaler

# ===============================================================
# DEVICE
# ===============================================================
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
print("Using device:", device)

# ===============================================================
# LOAD DATA (441 outputs)
# ===============================================================
project_dir = "/home/ved/projects"
data = pd.read_csv(os.path.join(project_dir, "Data3.csv"))

X = data[["X", "Y"]].values
S_cols = [f"S{i}" for i in range(1, 442)]
Y = data[S_cols].values   # shape (N, 441)

# ===============================================================
# NORMALIZATION
# ===============================================================
x_scaler = StandardScaler()
X = x_scaler.fit_transform(X)

y_scaler = StandardScaler()
Y = y_scaler.fit_transform(Y)   # per-feature normalization

# ===============================================================
# TRAIN-TEST SPLIT
# ===============================================================
from sklearn.model_selection import train_test_split
X_train, X_test, Y_train, Y_test = train_test_split(
    X, Y, test_size=0.1, random_state=42
)

# To tensors
X_train = torch.tensor(X_train, dtype=torch.float32).to(device)
Y_train = torch.tensor(Y_train, dtype=torch.float32).to(device)
X_test  = torch.tensor(X_test,  dtype=torch.float32).to(device)
Y_test  = torch.tensor(Y_test,  dtype=torch.float32).to(device)

# ===============================================================
# MODEL: 1024-NEURON MLP WITH LAYERNORM + SILU
# ===============================================================
class StressMLP(nn.Module):
    def __init__(self, in_dim=2, out_dim=441):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(in_dim, 1024),
            nn.ReLU(),
            nn.LayerNorm(1024),

            nn.Linear(1024, 1024),
            nn.SiLU(),
            nn.LayerNorm(1024),

            nn.Linear(1024, 1024),
            nn.SiLU(),
            nn.LayerNorm(1024),

            nn.Linear(1024, 1024),
            nn.SiLU(),
            nn.LayerNorm(1024),

            nn.Linear(1024, out_dim)
        )

    def forward(self, x):
        return self.net(x)

model = StressMLP().to(device)

# ===============================================================
# OPTIMIZER + SCHEDULER
# ===============================================================
optimizer = optim.Adam(model.parameters(), lr=1e-4)
scheduler = optim.lr_scheduler.StepLR(optimizer, step_size=300, gamma=0.5)
criterion_mse = nn.MSELoss()

# ===============================================================
# SAFE PEAK-WEIGHTED LOSS
# ===============================================================
def peak_loss(pred, true, alpha=1.2):
    peak = torch.max(true, dim=1, keepdim=True)[0]
    peak = peak.clamp(min=1e-6)

    w = (true / peak).clamp(0.0, 1.0) ** alpha

    return torch.mean(w * (pred - true)**2)

# ===============================================================
# TRAINING LOOP (STABLE)
# ===============================================================
epochs = 2000
for epoch in range(epochs):

    model.train()
    optimizer.zero_grad()

    pred = model(X_train)
    pred = pred.clamp(-5.0, 5.0)      # prevent exploding activations

    loss = criterion_mse(pred, Y_train) + 0.3 * peak_loss(pred, Y_train, alpha=1.2)

    if torch.isnan(loss):
        print("NaN detected! Stopping training.")
        break

    loss.backward()
    torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=0.5)  # stability
    optimizer.step()
    scheduler.step()

    if (epoch + 1) % 100 == 0:
        model.eval()
        with torch.no_grad():
            vpred = model(X_test).clamp(-5.0, 5.0)
            vloss = criterion_mse(vpred, Y_test).item()

        print(f"Epoch {epoch+1}/{epochs} | TrainLoss={loss.item():.6f} | ValLoss={vloss:.6f}")

