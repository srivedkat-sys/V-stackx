print("Training...")

for epoch in range(epochs):
    optimizer.zero_grad()
    outputs = forward_model(X_tensor)
    loss = criterion(outputs, y_tensor)
    loss.backward()
    optimizer.step()

    if epoch % 200 == 0 or epoch == epochs - 1:
        print(f"Epoch {epoch} Loss = {loss.item():.6f}")

