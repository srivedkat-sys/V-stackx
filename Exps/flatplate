import numpy as np
import matplotlib.pyplot as plt
from scipy import stats
from statsmodels.graphics.gofplots import qqplot
from statsmodels.stats.stattools import durbin_watson

# ------------------------------------------------------------
# 1. Compute Residuals
# ------------------------------------------------------------
residuals = (val_pred - val_y_true).flatten()

print("\n==============================")
print(" Statistical Validation (SV)")
print("==============================")
print(f"Total residual samples = {len(residuals)}")


# ------------------------------------------------------------
# 2. Histogram + PDF
# ------------------------------------------------------------
plt.figure(figsize=(7,5))
count, bins, _ = plt.hist(residuals, bins=40, density=True, alpha=0.6, color='gray', label="Residuals")

# Fit Gaussian PDF
mu, sigma = np.mean(residuals), np.std(residuals)
pdf = stats.norm.pdf(bins, mu, sigma)
plt.plot(bins, pdf, 'r-', label=f'Normal PDF (μ={mu:.4f}, σ={sigma:.4f})')

plt.title("Residual Histogram + Fitted Normal PDF")
plt.xlabel("Residual")
plt.ylabel("Density")
plt.legend()
plt.grid(True)
plt.show()


# ------------------------------------------------------------
# 3. Q–Q Plot
# ------------------------------------------------------------
plt.figure(figsize=(6,6))
qqplot(residuals, line='45')
plt.title("Q–Q Plot of Residuals")
plt.grid(True)
plt.show()


# ------------------------------------------------------------
# 4. Kolmogorov–Smirnov (KS) Test for Normality
# ------------------------------------------------------------
ks_stat, ks_p = stats.kstest(residuals, 'norm', args=(mu, sigma))

# ------------------------------------------------------------
# 5. Shapiro–Wilk Test
# ------------------------------------------------------------
shapiro_stat, shapiro_p = stats.shapiro(residuals[:5000])  # SW limit ~5000 samples

# ------------------------------------------------------------
# 6. Anderson–Darling Test
# ------------------------------------------------------------
ad_result = stats.anderson(residuals, dist='norm')

# ------------------------------------------------------------
# 7. Jarque–Bera Test
# ------------------------------------------------------------
jb_stat, jb_p = stats.jarque_bera(residuals)

# ------------------------------------------------------------
# 8. Skewness & Kurtosis
# ------------------------------------------------------------
skew_val  = stats.skew(residuals)
kurt_val  = stats.kurtosis(residuals)

# ------------------------------------------------------------
# 9. Durbin–Watson Autocorrelation Test
# ------------------------------------------------------------
dw_stat = durbin_watson(residuals)

# ------------------------------------------------------------
# PRINT SUMMARY
# ------------------------------------------------------------
print("\n--- Residual Statistics ---")
print(f"Mean     : {mu:.6f}")
print(f"Std Dev  : {sigma:.6f}")
print(f"Skewness : {skew_val:.6f}")
print(f"Kurtosis : {kurt_val:.6f}")

print("\n--- Normality Tests ---")
print(f"KS Test        : stat={ks_stat:.6f}, p={ks_p:.6f}")
print(f"Shapiro-Wilk   : stat={shapiro_stat:.6f}, p={shapiro_p:.6f}")
print(f"Jarque-Bera    : stat={jb_stat:.6f}, p={jb_p:.6f}")

print("\n--- Anderson-Darling Test ---")
print(f"Statistic: {ad_result.statistic:.6f}")
for sig, crit in zip(ad_result.significance_level, ad_result.critical_values):
    print(f"  {sig:.1f}% significance level: critical value={crit:.6f}")

print("\n--- Autocorrelation ---")
print(f"Durbin-Watson: {dw_stat:.6f}")
print("DW ≈ 2 means no autocorrelation. <2 positive correlation, >2 negative correlation.")

print("\nSV analysis complete.")




