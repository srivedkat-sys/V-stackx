X_val_tensor = torch.tensor(X_val_scaled, dtype=torch.float32).to(device)

# Predict
model.eval()
with torch.no_grad():
    Y_val_pred_scaled = model(X_val_tensor).cpu().numpy()

# Inverse-scale
Y_val_pred = y_scaler.inverse_transform(Y_val_pred_scaled)

# Errors
abs_errors = np.abs(Y_val_pred - Y_val_true)
mean_errors = np.mean(abs_errors, axis=1)
max_errors  = np.max(abs_errors, axis=1)

# Save results
results = pd.DataFrame({
    "X": X_val[:, 0],
    "Y": X_val[:, 1],
    "MeanError": mean_errors,
    "MaxError": max_errors
})
print("\nValidation Results (441 outputs):")
