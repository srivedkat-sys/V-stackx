# =====================================================
# HEATMAP FOR UNSTRUCTURED GRID
# =====================================================
def generate_heatmap_unstructured(pred, x_val, y_val, idx):
    grid_x, grid_y = np.mgrid[
        Xp.min():Xp.max():200j,
        Yp.min():Yp.max():200j
    ]

    Z_grid = griddata(
        (Xp, Yp),
        pred,
        (grid_x, grid_y),
        method='cubic'
    )

    plt.figure(figsize=(6,5))
    im = plt.imshow(
        Z_grid.T,
        extent=[Xp.min(), Xp.max(), Yp.min(), Yp.max()],
        origin='lower',
        cmap='jet',
        aspect='auto'
    )
    plt.scatter(x_val, y_val, color='red', s=40)
    plt.colorbar(im)
    plt.title(f"Heatmap #{idx} | Load at ({x_val:.3f}, {y_val:.3f})")
    plt.xlabel("X (m)")
    plt.ylabel("Y (m)")
    plt.show()

# =====================================================
# LOOP OVER VALIDATION POINTS
# =====================================================
print("\nGenerating heatmaps...\n")

for idx, (xv, yv) in enumerate(val_coords):
    generate_heatmap_unstructured(val_pred[idx], xv, yv, idx+1)
