# =====================================================
data = pd.read_csv(data_path)
y_stress = data.filter(regex='^S\d+').values   # shape (samples, 441)
X = coords[['X','Y']].values                   # 441 points

print("Training stress shape:", y_stress.shape)

# =====================================================
# SCALING
# =====================================================
stress_scaler = MinMaxScaler()
y_stress_scaled = stress_scaler.fit_transform(y_stress)

coord_scaler = MinMaxScaler()
X_scaled = coord_scaler.fit_transform(X)

X_tensor = torch.tensor(X, dtype=torch.float32).to(device)
y_tensor = torch.tensor(y_stress_scaled, dtype=torch.float32).to(device)

# =====================================================
# MODEL
# =====================================================
class MLP(nn.Module):
    def __init__(self, in_features, out_features):
        super().__init__()
        self.model = nn.Sequential(
            nn.Linear(in_features, 256),
            nn.ReLU(),
            nn.Linear(256, 256),
            nn.ReLU(),
            nn.Linear(256, 256),
            nn.ReLU(),
            nn.Linear(256, 256),
            nn.ReLU(),
            nn.Linear(256, 512),
            nn.ReLU(),
            nn.Linear(512, 1024),
            nn.ReLU(),
            nn.Linear(1024, 2048),
            nn.ReLU(),
            nn.Linear(2048, 4096),
            nn.ReLU(),
            nn.Linear(4096, out_features)   # 441 outputs
        )
    def forward(self, x):
        return self.model(x)

forward_model = MLP(in_features=2, out_features=y_stress.shape[1]).to(device)

criterion = nn.MSELoss()
optimizer = optim.Adam(forward_model.parameters(), lr=1e-3)

# =====================================================
# TRAINING
# =====================================================
