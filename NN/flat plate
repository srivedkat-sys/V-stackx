# StressNN (matches training)
# =====================
class StressNN(nn.Module):
    def __init__(self, in_features=2, out_features=out_features):
        super().__init__()
        self.input_layer = nn.Linear(in_features, 256)
        self.res1 = ResidualBlock(256)
        self.res2 = ResidualBlock(256)
        self.res3 = ResidualBlock(256)
        self.hidden = nn.Linear(256, 512)
        self.res4 = ResidualBlock(512)
