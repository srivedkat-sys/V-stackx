    )

    ix = np.argmin(np.abs(x_smooth - x_val))
    iy = np.argmin(np.abs(y_smooth - y_val))
    ax.scatter(x_smooth[ix], y_smooth[iy], Z_smooth[iy, ix], color='black', s=50)

    X_range = x_smooth.max() - x_smooth.min()
    Y_range = y_smooth.max() - y_smooth.min()
    Z_range = Z_smooth.max() - Z_smooth.min()
    ax.set_box_aspect([X_range, Y_range, Z_range*4])

    ax.set_xlabel('X (m)')
    ax.set_ylabel('Y (m)')
