from sklearn.preprocessing import MinMaxScaler

# =====================
# Paths
# =====================
project_dir = "/home/ved/projects"
coord_path = os.path.join(project_dir, "Coordinate.csv")
data_path = os.path.join(project_dir, "Data2.csv")

# =====================
# Load data
# =====================
coords = pd.read_csv(coord_path)
data = pd.read_csv(data_path)

# Inputs
X = coords[['X','Y']].values  # shape (121,2)

# Outputs (ONLY displacement)
y_disp = data.filter(regex='^N\d+').values   # Displacements only

print(f"Displacement shape: {y_disp.shape}")

# =====================
# Normalize displacement
# =====================
disp_scaler = MinMaxScaler()
y_disp_scaled = disp_scaler.fit_transform(y_disp)

# Convert to tensors
X_tensor = torch.tensor(X, dtype=torch.float32)
y_disp_tensor = torch.tensor(y_disp_scaled, dtype=torch.float32)

# =====================
# MLP Model (wide last layer)
# =====================
class MLPDisp(nn.Module):
    def __init__(self, in_features=2, out_features=121):
        super().__init__()
        self.model = nn.Sequential(
            nn.Linear(in_features, 128),
            nn.ReLU(),
            nn.Linear(128, 256),
            nn.ReLU(),
            nn.Linear(256, 512),   # widened layer
            nn.ReLU(),
            nn.Linear(512, out_features)  # wide last layer
        )
    def forward(self, x):
        return self.model(x)

# =====================
# Instantiate model
# =====================
disp_model = MLPDisp(in_features=2, out_features=y_disp.shape[1])
criterion = nn.MSELoss()
optimizer = optim.Adam(disp_model.parameters(), lr=1e-3)
scheduler = optim.lr_scheduler.StepLR(optimizer, step_size=1000, gamma=0.9)

# =====================
# Training loop
# =====================
def train(model, optimizer, scheduler, X_tensor, y_tensor, epochs=10000, name="Displacement"):
    for epoch in range(epochs):
        optimizer.zero_grad()
        outputs = model(X_tensor)
        loss = criterion(outputs, y_tensor)
        loss.backward()
        optimizer.step()
        scheduler.step()

        if epoch % 500 == 0 or epoch == epochs-1:
            print(f"[{name}] Epoch {epoch}, Loss: {loss.item():.6f}")

print("Training Displacement Model (normalized)...")
train(disp_model, optimizer, scheduler, X_tensor, y_disp_tensor)

# =====================
