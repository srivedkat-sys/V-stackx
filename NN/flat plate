import os
import numpy as np
import pandas as pd
import torch
import torch.nn as nn
import torch.optim as optim
from sklearn.preprocessing import MinMaxScaler, StandardScaler

# =====================
# Paths
# =====================
project_dir = "/home/ved/projects"
coord_path  = os.path.join(project_dir, "Coordinate.csv")
data_path   = os.path.join(project_dir, "Data2.csv")
model_path  = os.path.join(project_dir, "mlp_stress_improved.pth")
scaler_path = os.path.join(project_dir, "stress_scaler_improved.npz")
input_scaler_path = os.path.join(project_dir, "input_scaler_improved.npz")

# =====================
# Load data
# =====================
coords = pd.read_csv(coord_path)
data   = pd.read_csv(data_path)

# Inputs = X,Y
X_raw = coords[['X','Y']].values  # shape (121,2)

# Outputs = Stress only
y_stress = data.filter(regex='^S\d+').values  # shape (121,121)
print(f"Original stress shape: {y_stress.shape}")

# =====================
# Normalize inputs
# =====================
input_scaler = MinMaxScaler()
X = input_scaler.fit_transform(X_raw)

# =====================
# Log-transform stress
# =====================
y_stress_log = np.log1p(y_stress)

# Standardize output
output_scaler = StandardScaler()
y = output_scaler.fit_transform(y_stress_log)

# Convert to tensors
X_tensor = torch.tensor(X, dtype=torch.float32)
y_tensor = torch.tensor(y, dtype=torch.float32)

# =====================
# Residual Block
# =====================
class ResidualBlock(nn.Module):
    def __init__(self, features):
        super().__init__()
        self.block = nn.Sequential(
            nn.Linear(features, features),
            nn.SiLU(),
            nn.Linear(features, features)
        )
    def forward(self, x):
        return x + self.block(x)

# =====================
# StressNN with residual blocks
# =====================
class StressNN(nn.Module):
    def __init__(self, in_features=2, out_features=y.shape[1]):
        super().__init__()
        self.input_layer = nn.Linear(in_features, 256)
        self.res1 = ResidualBlock(256)
        self.res2 = ResidualBlock(256)
        self.res3 = ResidualBlock(256)
        self.hidden = nn.Linear(256, 512)
        self.res4 = ResidualBlock(512)
        self.res5 = ResidualBlock(512)
        self.output_layer = nn.Linear(512, out_features)
        self.act = nn.SiLU()
        
    def forward(self, x):
        x = self.act(self.input_layer(x))
        x = self.res1(x)
        x = self.res2(x)
        x = self.res3(x)
        x = self.act(self.hidden(x))
        x = self.res4(x)
        x = self.res5(x)
        x = self.output_layer(x)
        return x

# =====================
# Training setup
# =====================
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
model = StressNN().to(device)
criterion = nn.SmoothL1Loss()  # Huber loss
optimizer = optim.Adam(model.parameters(), lr=1e-3)
scheduler = optim.lr_scheduler.StepLR(optimizer, step_size=1000, gamma=0.9)

X_tensor = X_tensor.to(device)
y_tensor = y_tensor.to(device)

# =====================
# Training loop
# =====================
def train(model, optimizer, scheduler, X, y, epochs=10000):
    for epoch in range(epochs):
        optimizer.zero_grad()
        outputs = model(X)
        loss = criterion(outputs, y)
        loss.backward()
        optimizer.step()
        scheduler.step()
        
        if epoch % 500 == 0 or epoch == epochs-1:
            print(f"Epoch {epoch}, Loss: {loss.item():.6f}")

print("🚀 Training Improved Stress Model...")
train(model, optimizer, scheduler, X_tensor, y_tensor)

# =====================
# Save model and scalers
# =====================
torch.save(model.state_dict(), model_path)
np.savez(scaler_path, mean=output_scaler.mean_, scale=output_scaler.scale_)
np.savez(input_scaler_path, min=input_scaler.min_, scale=input_scaler.scale_)

print("Training complete! Model and scalers saved.")


