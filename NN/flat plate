# =====================
# MLP Model
# =====================
class MLP(nn.Module):
    def __init__(self, in_features, out_features):
        super().__init__()
        self.model = nn.Sequential(
            nn.Linear(in_features, 256),
            nn.ReLU(),
            nn.Linear(256, 256),
            nn.ReLU(),                
            nn.Linear(256, 256),
            nn.ReLU(),
            nn.Linear(256, 256),
            nn.ReLU(),
            nn.Linear(256, 1024),
            nn.ReLU(),
            nn.Linear(1024, 1024),
            nn.ReLU(),
            nn.Linear(1024, 2048),
            nn.ReLU(),
            nn.Linear(2048, out_features)
        )
    def forward(self, x):
        return self.model(x)

# =====================
# Instantiate models
# =====================
forward_model = MLP(in_features=2, out_features=y_stress.shape[1])  # stress field
inverse_model = MLP(in_features=1, out_features=2)  # input: max stress value → (X,Y)

# Loss and optimizer
criterion = nn.MSELoss()
fwd_optimizer = optim.Adam(forward_model.parameters(), lr=1e-3)
inv_optimizer = optim.Adam(inverse_model.parameters(), lr=1e-3)

# =====================
# Training forward model
# =====================
epochs = 8000
print("Training forward model on STRESS...")
for epoch in range(epochs):
    fwd_optimizer.zero_grad()
    outputs = forward_model(X_tensor)
    loss = criterion(outputs, y_tensor)
    loss.backward()
    fwd_optimizer.step()

    if epoch % 500 == 0 or epoch == epochs - 1:
        print(f"[Forward-Stress] Epoch {epoch}, Loss: {loss.item():.6f}")




